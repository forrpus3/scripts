local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local p = Players.LocalPlayer

local target = nil
local running = false
local settingUp = false
local strafeDistance = 4
local strafeMode = "behind"

local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

local function animate(obj, properties)
    TweenService:Create(obj, tweenInfo, properties):Play()
end

local function createButton(text, parent, pos)
    local btn = Instance.new("TextButton", parent)
    btn.Text = text
    btn.Size = UDim2.new(0.9, 0, 0, 50)
    btn.Position = pos
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.BackgroundColor3 = Color3.fromRGB(60, 60, 80)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 18
    btn.BorderSizePixel = 0
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
    btn.MouseEnter:Connect(function() animate(btn, {BackgroundColor3 = Color3.fromRGB(80, 80, 100)}) end)
    btn.MouseLeave:Connect(function() animate(btn, {BackgroundColor3 = Color3.fromRGB(60, 60, 80)}) end)
    return btn
end

local function createBox(placeholder, parent, pos)
    local box = Instance.new("TextBox", parent)
    box.Size = UDim2.new(0.9, 0, 0, 45)
    box.Position = pos
    box.PlaceholderText = placeholder
    box.Text = ""
    box.TextColor3 = Color3.fromRGB(255, 255, 255)
    box.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    box.Font = Enum.Font.Gotham
    box.TextSize = 16
    box.BorderSizePixel = 0
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 8)
    return box
end

local function doSetup()
    settingUp = true
    local char = p.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.CFrame = CFrame.new(-206.834, 7.000, 319.024)
        task.wait(3.5) -- Increased slightly to ensure full load
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("ProximityPrompt") then
                local part = v.Parent
                local pos = (part:IsA("BasePart") and part.Position) or (part:FindFirstChildWhichIsA("BasePart") and part:FindFirstChildWhichIsA("BasePart").Position)
                if pos and (pos - Vector3.new(-206.834, 7.000, 319.024)).Magnitude < 20 then
                    fireproximityprompt(v)
                end
            end
        end
    end
    task.wait(1.0)
    settingUp = false
end

-- UI Initialization
local sg = Instance.new("ScreenGui", p:WaitForChild("PlayerGui"))
sg.Name = "StrafeUI"
sg.ResetOnSpawn = false

local mainFrame = Instance.new("Frame", sg)
mainFrame.Size = UDim2.new(0, 280, 0, 300)
mainFrame.Position = UDim2.new(0.5, -140, 0.5, -150)
mainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
Instance.new("UICorner", mainFrame).CornerRadius = UDim.new(0, 12)

-- Draggable Logic
local dragging, dragStart, startPos
mainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
end)

local nameBox = createBox("Target Name...", mainFrame, UDim2.new(0.05, 0, 0.1, 0))
nameBox.FocusLost:Connect(function()
    for _, v in pairs(Players:GetPlayers()) do
        if string.find(v.Name:lower(), nameBox.Text:lower()) then
            nameBox.Text = v.Name
            target = v.Character
            break
        end
    end
end)

local distBox = createBox("Distance (default: 4)", mainFrame, UDim2.new(0.05, 0, 0.35, 0))
distBox.FocusLost:Connect(function() strafeDistance = tonumber(distBox.Text) or 4 end)

local modeBox = createBox("Mode (front/behind)", mainFrame, UDim2.new(0.05, 0, 0.60, 0))
modeBox.FocusLost:Connect(function() strafeMode = modeBox.Text:lower() end)

local toggleBtn = createButton("START", mainFrame, UDim2.new(0.05, 0, 0.82, 0))
toggleBtn.MouseButton1Click:Connect(function()
    running = not running
    if running then task.spawn(doSetup) end
    toggleBtn.Text = running and "STOP" or "START"
    animate(toggleBtn, {BackgroundColor3 = running and Color3.fromRGB(150, 40, 40) or Color3.fromRGB(40, 150, 80)})
end)

-- Main Loop: Handles persistent re-setup on respawn
task.spawn(function()
    while true do
        if not p.Character or not p.Character:FindFirstChild("HumanoidRootPart") then
            p.CharacterAdded:Wait()
            task.wait(1.0) -- Give time to load
            
            -- Re-trigger setup automatically if running
            if running then 
                task.spawn(doSetup) 
            end
        end
        
        if running and not settingUp and target and target:FindFirstChild("HumanoidRootPart") then
            local char = p.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local currentRoot = char.HumanoidRootPart
                local root = target.HumanoidRootPart
                local offset = (strafeMode == "front") and -strafeDistance or strafeDistance
                local goalCFrame = CFrame.new((root.CFrame * CFrame.new(0, 0, offset)).Position, root.Position)
                currentRoot.CFrame = currentRoot.CFrame:Lerp(goalCFrame, 0.3)
            end
        end
        task.wait(0.03)
    end
end)

-- Combat Loop
task.spawn(function()
    while true do
        if running and not settingUp and target then
            local char = p.Character
            if char and char:FindFirstChild("Humanoid") and char.Humanoid.Health > 0 then
                local r = p:FindFirstChild("CHServer") and p.CHServer:FindFirstChild("Remotes") and p.CHServer.Remotes:FindFirstChild("Input")
                if r then
                    r:FireServer("M1", true, 397.77875450000283)
                    task.wait(0.05)
                    r:FireServer("M1", false, 397.77875450000283)
                    task.wait(0.6)
                end
            end
        end
        task.wait(0.1)
    end
end)
