-- Function to get team color
local function getTeamColor(plr)
	if plr.Team then
		return plr.Team.TeamColor.Color
	end
	return Color3.fromRGB(255, 255, 255) -- Default white if no team
end

-- Function to create player billboard
local function createPlayerBillboard(character, plr)
	if playerBillboards[character] then return end
	
	local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
	if not torso then return end
	
	local humanoid = character:FindFirstChild("Humanoid")
	if not humanoid then return end
	
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "PlayerLabel"
	billboard.Adornee = torso
	billboard.Size = UDim2.new(0, 200, 0, 50)
	billboard.StudsOffset = Vector3.new(3, 0, 0)
	billboard.AlwaysOnTop = true
	billboard.Parent = torso
	
	local textLabel = Instance.new("TextLabel")
	textLabel.Size = UDim2.new(1, 0, 1, 0)
	textLabel.BackgroundTransparency = 1
	textLabel.TextColor3 = getTeamColor(plr)
	textLabel.TextSize = 14
	textLabel.Font = Enum.Font.GothamBold
	textLabel.TextStrokeTransparency = 0.5
	textLabel.TextStrokeColor3 = LABEL_STROKE_COLOR
	textLabel.TextXAlignment = Enum.TextXAlignment.Left
	textLabel.Parent = billboard
	
	-- Update health text
	local function updateText()
		if humanoid and plr then
			local teamName = plr.Team and plr.Team.Name or "No Team"
			local health = math.floor(humanoid.Health)
			local maxHealth = math.floor(humanoid.MaxHealth)
			textLabel.Text = string.format("%s\nHP: %d/%d", teamName, health, maxHealth)
			textLabel.TextColor3 = getTeamColor(plr)
		end
	end
	
	updateText()
	humanoid.HealthChanged:Connect(updateText)
	
	if plr then
		plr:GetPropertyChangedSignal("Team"):Connect(updateText)
	end
	
	playerBillboards[character] = {billboard = billboard, update = updateText}
end

-- Function to create player highlight
local function createPlayerHighlight(character, plr)
	if playerHighlights[character] then return end
	
	local highlight = Instance.new("Highlight")
	highlight.Name = "PlayerHighlight"
	highlight.Adornee = character
	highlight.FillColor = getTeamColor(plr)
	highlight.OutlineColor = getTeamColor(plr)
	highlight.FillTransparency = FILL_TRANSPARENCY
	highlight.OutlineTransparency = OUTLINE_TRANSPARENCY
	highlight.Parent = character
	
	playerHighlights[character] = highlight
	createPlayerBillboard(character, plr)
	
	-- Update color when team changes
	if plr then
		plr:GetPropertyChangedSignal("Team"):Connect(function()
			local newColor = getTeamColor(plr)
			highlight.FillColor = newColor
			highlight.OutlineColor = newColor
		end)
	end
end

-- Function to remove player highlight
local function removePlayerHighlight(character)
	if playerHighlights[character] then
		playerHighlights[character]:Destroy()
		playerHighlights[character] = nil
	end
	if playerBillboards[character] then
		if playerBillboards[character].billboard then
			playerBillboards[character].billboard:Destroy()
		end
		playerBillboards[character] = nil
	end
end

-- Function to clear all player highlights
function clearAllPlayerHighlights()
	for character, _ in pairs(playerHighlights) do
		removePlayerHighlight(character)
	end
end

-- Function to update item highlights based on distance
local function updateItemHighlights()
	if not itemEspEnabled then return end
	
	local itemSpawns = workspace:FindFirstChild("ItemSpawns")
	if not itemSpawns then return end
	
	for _, item in ipairs(itemSpawns:GetDescendants()) do
		if item:IsA("Model") then
			if isWithinRange(item) then
				if not itemHighlights[item] then
					createItemHighlight(item)
				end
			else
				if itemHighlights[item] then
					removeItemHighlight(item)
				end
			end
		end
	end
	
	-- Clean up highlights for models that no longer exist
	for model, _ in pairs(itemHighlights) do
		if not model.Parent or not model:IsDescendantOf(itemSpawns) then
			removeItemHighlight(model)
		end
	end
end

-- Function to setup player ESP
local function setupPlayerESP(plr)
	if plr == player then return end
	
	local function onCharacterAdded(character)
		if not playerEspEnabled then return end
		if not shouldHighlightPlayer(plr) then return end
		
		character:WaitForChild("HumanoidRootPart")
		task.wait(0.5)
		
		createPlayerHighlight(character, plr)
	end
	
	plr:GetPropertyChangedSignal("Team"):Connect(function()
		if plr.Character then
			if shouldHighlightPlayer(plr) then
				if not playerHighlights[plr.Character] then
					createPlayerHighlight(plr.Character, plr)
				end
			else
				removePlayerHighlight(plr.Character)
			end
		end
	end)
	
	if plr.Character then
		onCharacterAdded(plr.Character)
	end
	
	plr.CharacterAdded:Connect(onCharacterAdded)
end

local function updatePlayerESP()
	if not playerEspEnabled then return end
	
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player and plr.Character and shouldHighlightPlayer(plr) then
			if not playerHighlights[plr.Character] then
				createPlayerHighlight(plr.Character, plr)
			end
		end
	end
	
	for character, _ in pairs(playerHighlights) do
		if not character.Parent then
			removePlayerHighlight(character)
		end
	end
end

createGUI()

for _, plr in ipairs(Players:GetPlayers()) do
