				TextColor3 = Color3.fromRGB(255, 255, 255)
			}):Play()
			fovToggle.Text = "✓ FOV Circle"
			createFOVCircle()
		else
			TweenService:Create(fovToggle, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				BackgroundColor3 = Color3.fromRGB(231, 76, 60),
				TextColor3 = Color3.fromRGB(255, 255, 255)
			}):Play()
			fovToggle.Text = "✕ FOV Circle"
		end
	end)
	
	-- Entrance animation
	frame.Size = UDim2.new(0, 0, 0, 0)
	frame.Position = UDim2.new(0, 77, 0.5, 0)
	TweenService:Create(frame, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Size = UDim2.new(0, 154, 0, 260),
		Position = UDim2.new(0, 10, 0.5, -130)
	}):Play()
	
	return screenGui
end

-- Function to create item billboard
local function createItemBillboard(model)
