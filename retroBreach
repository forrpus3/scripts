workspace.DescendantAdded:Connect(function(descendant)
	if not itemEspEnabled then return end
	if descendant:IsA("Model") and descendant:IsDescendantOf(workspace:FindFirstChild("ItemSpawns") or Instance.new("Folder")) then
		task.wait(0.1)
		if isWithinRange(descendant) then
			createItemHighlight(descendant)
		end
	end
	
	if xrayEnabled and descendant:IsA("BasePart") then
		local isPlayerPart = false
		local ancestor = descendant.Parent
		while ancestor do
			if ancestor:IsA("Model") and Players:GetPlayerFromCharacter(ancestor) then
				isPlayerPart = true
				break
			end
			if ancestor.Name == "ItemSpawns" then
				isPlayerPart = true
				break
			end
			ancestor = ancestor.Parent
		end
		
		if not isPlayerPart and descendant.Transparency < 1 then
			if not originalTransparencies[descendant] then
				originalTransparencies[descendant] = descendant.Transparency
			end
			descendant.Transparency = XRAY_TRANSPARENCY
		end
	end
end)

workspace.DescendantRemoving:Connect(function(descendant)
	if descendant:IsA("Model") and itemHighlights[descendant] then
		removeItemHighlight(descendant)
	end
	
	if originalTransparencies[descendant] then
		originalTransparencies[descendant] = nil
	end
end)

