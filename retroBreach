-- Function to create FOV circle
local function createFOVCircle()
	if fovCircle then return end
	
	local screenGui = player.PlayerGui:FindFirstChild("ESP_GUI")
	if not screenGui then return end
	
	fovCircle = Drawing.new("Circle")
	fovCircle.Thickness = 2
	fovCircle.NumSides = 64
	fovCircle.Radius = AIMBOT_FOV
	fovCircle.Filled = false
	fovCircle.Visible = fovCircleEnabled
	fovCircle.Color = Color3.fromRGB(100, 200, 255)
	fovCircle.Transparency = 0.8
	
	return fovCircle
end

-- Function to update FOV circle position
local function updateFOVCircle()
	if not fovCircle then return end
	
	local screenSize = camera.ViewportSize
	fovCircle.Position = Vector2.new(screenSize.X / 2, screenSize.Y / 2)
	fovCircle.Visible = fovCircleEnabled and aimbotEnabled
end

-- Function to remove FOV circle
local function removeFOVCircle()
	if fovCircle then
		fovCircle:Remove()
		fovCircle = nil
	end
end

-- Function to check if player should be highlighted
local function shouldHighlightPlayer(plr)
	if plr == player then return false end -- Don't highlight yourself
	
	-- If no team system, highlight all players
	if not plr.Team then return true end
	
	local teamName = plr.Team.Name
	if teamName == "Lobby" or teamName == "FFA" then
		return false -- Don't highlight Lobby or FFA teams
	end
	
	-- Don't highlight same team
	if player.Team and plr.Team == player.Team then
		return false
	end
	
	return true
end

-- Function to get player position
local function getPlayerPosition()
	local character = player.Character
	if character and character:FindFirstChild("HumanoidRootPart") then
		return character.HumanoidRootPart.Position
	end
	return nil
end

-- Function to get model position
local function getModelPosition(model)
	local primaryPart = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
	if primaryPart then
		return primaryPart.Position
	end
	return nil
end

-- Function to check if model is within range
local function isWithinRange(model)
	local playerPos = getPlayerPosition()
	local modelPos = getModelPosition(model)
	
	if playerPos and modelPos then
		local distance = (playerPos - modelPos).Magnitude
		return distance <= MAX_DISTANCE
	end
	return false
end

-- =====================
-- MOBILE SOFT-LOCK AIMBOT (FIXED)
-- =====================
local SWITCH_DOT_THRESHOLD = 0.98 -- lower = easier switching on mobile

local function shouldTarget(plr)
	if plr == player then return false end
	if not plr.Character then return false end
	if player.Team and plr.Team == player.Team then return false end
	return true
end

local function getClosestPlayerToCrosshair()
	local closestChar = nil
	local shortest = math.huge
	local screenCenter = camera.ViewportSize / 2
	for _, plr in ipairs(Players:GetPlayers()) do
		if shouldTarget(plr) then
			local char = plr.Character
			local head = char and char:FindFirstChild("Head")
			local humanoid = char and char:FindFirstChild("Humanoid")
			if head and humanoid and humanoid.Health > 0 then
				local screenPos, onScreen = camera:WorldToViewportPoint(head.Position)
				if onScreen and screenPos.Z > 0 then
					local dist = (Vector2.new(screenPos.X, screenPos.Y) - screenCenter).Magnitude
					if dist < shortest and dist < AIMBOT_FOV then
						shortest = dist
						closestChar = char
					end
				end
			end
		end
	end
	return closestChar
end

local function updateAimbot()
	if not aimbotEnabled then
		lockedTarget = nil
		return
	end
	-- Break lock when player swipes camera away (MOBILE)
	if lockedTarget then
		local head = lockedTarget:FindFirstChild("Head")
		if not head then
			lockedTarget = nil
		else
			local camPos = camera.CFrame.Position
			local camLook = camera.CFrame.LookVector
			local targetDir = (head.Position - camPos).Unit
			if camLook:Dot(targetDir) < SWITCH_DOT_THRESHOLD then
				lockedTarget = nil
			end
		end
	end
	-- Always re-acquire whoever you're aiming at
	lockedTarget = getClosestPlayerToCrosshair()
	-- Aim smoothly
	if lockedTarget then
		local head = lockedTarget:FindFirstChild("Head")
		if head then
			local camPos = camera.CFrame.Position
			local currentDir = camera.CFrame.LookVector
			local targetDir = (head.Position - camPos).Unit
			local alpha = math.clamp(AIMBOT_SMOOTHNESS * 0.2, 0.03, 0.15)
			local smoothDir = currentDir:Lerp(targetDir, alpha)
			camera.CFrame = CFrame.new(camPos, camPos + smoothDir)
		end
	end
end

local function applyXRay()
	for _, obj in pairs(workspace:GetDescendants()) do
		if obj:IsA("BasePart") then
			-- Skip player characters and items
			local isPlayerPart = false
			local ancestor = obj.Parent
			while ancestor do
				if ancestor:IsA("Model") and Players:GetPlayerFromCharacter(ancestor) then
					isPlayerPart = true
					break
				end
				if ancestor.Name == "ItemSpawns" then
					isPlayerPart = true
					break
				end
				ancestor = ancestor.Parent
			end
			
			if not isPlayerPart and obj.Transparency < 1 then
				if not originalTransparencies[obj] then
					originalTransparencies[obj] = obj.Transparency
				end
				obj.Transparency = XRAY_TRANSPARENCY
			end
		end
	end
end

local function removeXRay()
	for obj, originalTrans in pairs(originalTransparencies) do
		if obj and obj.Parent then
			obj.Transparency = originalTrans
		end
	end
	originalTransparencies = {}
end

-- Function to make GUI draggable with animation
local function makeDraggable(frame)
	local dragging
	local dragInput
	local dragStart
	local startPos
	local originalSize = frame.Size
	
	local function update(input)
		local delta = input.Position - dragStart
		frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end
	
	frame.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = frame.Position
			
			-- Scale down animation when dragging starts
			TweenService:Create(frame, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Size = UDim2.new(originalSize.X.Scale * 0.95, originalSize.X.Offset * 0.95, originalSize.Y.Scale * 0.95, originalSize.Y.Offset * 0.95)
			}):Play()
			
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
					-- Scale back to original when drag ends
					TweenService:Create(frame, TweenInfo.new(0.2, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
						Size = originalSize
					}):Play()
				end
			end)
		end
	end)
	
	frame.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)
	
	UserInputService.InputChanged:Connect(function(input)
		if input == dragInput and dragging then
			update(input)
		end
	end)
end

-- Function to animate button
local function animateButton(button)
	button.MouseEnter:Connect(function()
		TweenService:Create(button, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = UDim2.new(0, 119, 0, 27),
			Position = UDim2.new(0.5, -59.5, button.Position.Y.Scale, button.Position.Y.Offset)
		}):Play()
	end)
	
	button.MouseLeave:Connect(function()
		TweenService:Create(button, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = UDim2.new(0, 112, 0, 25),
			Position = UDim2.new(0.5, -56, button.Position.Y.Scale, button.Position.Y.Offset)
		}):Play()
	end)
	
	button.MouseButton1Down:Connect(function()
		TweenService:Create(button, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = UDim2.new(0, 108, 0, 23)
		}):Play()
	end)
	
	button.MouseButton1Up:Connect(function()
		TweenService:Create(button, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = UDim2.new(0, 119, 0, 27)
		}):Play()
	end)
end

