--[[
    Restoration Essence Hub + Fluent UI (Ultimate Edition)
    -------------------------------------------------
    • Essence & Tool ESP (10s scan, frame-perfect distance)
    • Player ESP
    • AutoFarm (Essences & Tools) via physical touch simulation
    • LocalPlayer Mods (WalkSpeed, JumpPower, Inf Jump, Fullbright)
    • Server Hopping
--]]

-- // Services
local RunService       = game:GetService("RunService")
local Players          = game:GetService("Players")
local Workspace        = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")
local Lighting         = game:GetService("Lighting")
local HttpService      = game:GetService("HttpService")
local TeleportService  = game:GetService("TeleportService")

-- // Fetch Fluent UI
local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()

-- // Configuration
local CONFIG = {
    ItemName       = "Restoration Essence",
    Color          = Color3.fromRGB(0, 255, 0),
    PlayerESPColor = Color3.fromRGB(255, 0, 0),
    Transparency   = 0.2,
    ScanInterval   = 10,
    GrabInterval   = 3.5,
    Enabled        = true,
    ShowDistance   = true,
    MaxDistance    = 0,
    AutoFarm       = false,
    GrabAllTools   = false,
    PlayerESP      = false,
    WalkSpeed      = 16,
    JumpPower      = 50,
    InfJump        = false,
    Fullbright     = false,
}

-- // Internal State
local highlighted    = {}
local indicators     = {}
local highlightCount = 0
local MAX_HIGHLIGHTS = 31
local lastGrab       = {}

local player = Players.LocalPlayer

-- // Original Lighting Backup
local DefaultLighting = {
    Ambient = Lighting.Ambient,
    Brightness = Lighting.Brightness,
    ClockTime = Lighting.ClockTime,
    GlobalShadows = Lighting.GlobalShadows
}

-- // Helpers
local function isGroundItem(target)
    if not target or not target.Parent then return false end
    local current = target
    while current and current ~= Workspace do
        if current:IsA("Backpack") or current:FindFirstChildOfClass("Humanoid") or Players:GetPlayerFromCharacter(current) then
            return false
        end
        current = current.Parent
    end
    return true
end

local function getPartInfo(target)
    if not target or not target.Parent then return nil, nil end
    if target:IsA("BasePart") then
        return target.Position, target.Size
    elseif target:IsA("Model") or target:IsA("Tool") then
        local primary = target.PrimaryPart or target:FindFirstChildWhichIsA("BasePart")
        if primary then return primary.Position, primary.Size end
        local cf, size = target:GetBoundingBox()
        return cf.Position, size
    end
    return nil, nil
end

-- // ESP Management
local function attachHighlight(target, isPlayer)
    if not (target:IsA("BasePart") or target:IsA("Model")) then return end
    if highlighted[target] then return end
    if highlightCount >= MAX_HIGHLIGHTS then return end

    local highlight = Instance.new("Highlight")
    local col = isPlayer and CONFIG.PlayerESPColor or CONFIG.Color
    
    highlight.FillColor           = col
    highlight.OutlineColor        = col
    highlight.FillTransparency    = CONFIG.Transparency
    highlight.OutlineTransparency = 0
    highlight.Adornee             = target
    highlight.Parent              = target

    highlighted[target] = highlight
    highlightCount += 1
end

local function detachHighlight(target)
    local highlight = highlighted[target]
    if highlight then
        highlight:Destroy()
        highlighted[target] = nil
        highlightCount -= 1
    end
    local indicator = indicators[target]
    if indicator then
        indicator:Destroy()
        indicators[target] = nil
    end
    lastGrab[target] = nil
end

local function createIndicator(target, prefix)
    if not (target:IsA("BasePart") or target:IsA("Model")) then return end
    if indicators[target] then return indicators[target] end

    local bb = Instance.new("BillboardGui")
    bb.Name = "DistanceIndicator"
    bb.Adornee = target
    bb.Size = UDim2.new(0, 200, 0, 50)
    bb.AlwaysOnTop = true

    local _, size = getPartInfo(target)
    local offsetY = (size and size.Y / 2) or 0
    bb.StudsOffset = Vector3.new(0, offsetY + 2, 0)

    local tl = Instance.new("TextLabel")
    tl.Name = "DistanceText"
    tl.Size = UDim2.new(1, 0, 1, 0)
    tl.BackgroundTransparency = 1
    tl.TextStrokeTransparency = 0.75
    tl.TextColor3 = Color3.fromRGB(255, 255, 255)
    tl.Font = Enum.Font.SourceSansBold
    tl.TextScaled = true
    
    -- Store prefix (e.g. Player Name) as an attribute to use during updates
    if prefix then tl:SetAttribute("Prefix", prefix) end
    
    tl.Parent = bb
    bb.Parent = target
    indicators[target] = bb
    return bb
end

-- // Grab Logic (Using Physical Touch Bypass)
local function grabItem(target)
    if not target or not target.Parent then return end
    if not isGroundItem(target) then return end

    local character = player.Character
    if not character then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    
    local handle = target:IsA("BasePart") and target 
        or target:FindFirstChild("Handle") 
        or target:FindFirstChildWhichIsA("BasePart")

    if hrp and handle and firetouchinterest then
        firetouchinterest(hrp, handle, 0)
        task.wait(0.05)
        firetouchinterest(hrp, handle, 1)
    else
        -- Fallback local reparenting
        local backpack = player:FindFirstChild("Backpack")
        if backpack then target.Parent = backpack end
    end
end

-- // AutoFarm Functions
local function runAutoFarm()
    if not CONFIG.AutoFarm then return end
    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")

    for _, desc in ipairs(Workspace:GetDescendants()) do
        if desc.Name == CONFIG.ItemName and (desc:IsA("BasePart") or desc:IsA("Model")) and isGroundItem(desc) then
            if hrp then
                local pos = getPartInfo(desc)
                if pos and (CONFIG.MaxDistance == 0 or (hrp.Position - pos).Magnitude <= CONFIG.MaxDistance) then
                    grabItem(desc)
                end
            else
                grabItem(desc)
            end
        end
    end
end

local function runGrabAllTools()
    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    for _, desc in ipairs(Workspace:GetDescendants()) do
        if desc:IsA("Tool") and isGroundItem(desc) then
            if hrp then
                local pos = getPartInfo(desc)
                if pos and (CONFIG.MaxDistance == 0 or (hrp.Position - pos).Magnitude <= CONFIG.MaxDistance) then
                    grabItem(desc)
                end
            else
                grabItem(desc)
            end
        end
    end
end

-- // Update ESP & Player ESP
local function updateESP()
    -- Cleanup Stale Targets
    for t in pairs(highlighted) do
        if not t.Parent then
            detachHighlight(t)
        end
    end

    -- 1. Scan Items
    if CONFIG.Enabled then
        for _, desc in ipairs(Workspace:GetDescendants()) do
            if desc.Name == CONFIG.ItemName and (desc:IsA("BasePart") or desc:IsA("Model")) then
                attachHighlight(desc, false)
                createIndicator(desc)
            end
        end
    end

    -- 2. Scan Players
    if CONFIG.PlayerESP then
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                attachHighlight(p.Character, true)
                createIndicator(p.Character, p.Name)
            end
        end
    else
        -- Remove Player ESP if toggled off
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character and highlighted[p.Character] then
                detachHighlight(p.Character)
            end
        end
    end
end

-- // Server Hop Logic
local function serverHop()
    local servers = {}
    local req = request or http_request or (syn and syn.request)
    if not req then return end
    
    local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Desc&limit=100"
    local response = req({Url = url, Method = "GET"})
    
    if response and response.Body then
        local body = HttpService:JSONDecode(response.Body)
        if body and body.data then
            for _, v in pairs(body.data) do
                if type(v) == "table" and v.playing < v.maxPlayers and v.id ~= game.JobId then
                    table.insert(servers, 1, v.id)
                end
            end
        end
        if #servers > 0 then
            TeleportService:TeleportToPlaceInstance(game.PlaceId, servers[math.random(1, #servers)], player)
        end
    end
end

-- // Spawn Handlers & Loops
Workspace.DescendantAdded:Connect(function(desc)
    if desc.Name == CONFIG.ItemName and (desc:IsA("BasePart") or desc:IsA("Model")) then
        if CONFIG.Enabled then
            attachHighlight(desc, false)
            createIndicator(desc)
        end
        if CONFIG.AutoFarm and isGroundItem(desc) then grabItem(desc) end
    end
    if desc:IsA("Tool") and CONFIG.GrabAllTools and isGroundItem(desc) then
        grabItem(desc)
    end
end)

UserInputService.JumpRequest:Connect(function()
    if CONFIG.InfJump and player.Character then
        local hum = player.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end
end)

task.spawn(function()
    while true do
        updateESP()
        task.wait(CONFIG.ScanInterval)
    end
end)

task.spawn(function()
    while true do
        if CONFIG.AutoFarm then runAutoFarm() end
        if CONFIG.GrabAllTools then runGrabAllTools() end
        task.wait(CONFIG.GrabInterval)
    end
end)

-- // Render Loop (Visuals & Char Mods)
RunService.RenderStepped:Connect(function()
    local character = player.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local hum = character and character:FindFirstChildOfClass("Humanoid")

    -- Enforce Character Mods
    if hum then
        if CONFIG.WalkSpeed ~= 16 then hum.WalkSpeed = CONFIG.WalkSpeed end
        if CONFIG.JumpPower ~= 50 then hum.JumpPower = CONFIG.JumpPower end
    end

    -- Enforce Fullbright
    if CONFIG.Fullbright then
        Lighting.Ambient = Color3.new(1, 1, 1)
        Lighting.Brightness = 2
        Lighting.ClockTime = 14
        Lighting.GlobalShadows = false
    else
        Lighting.Ambient = DefaultLighting.Ambient
        Lighting.Brightness = DefaultLighting.Brightness
        Lighting.ClockTime = DefaultLighting.ClockTime
        Lighting.GlobalShadows = DefaultLighting.GlobalShadows
    end

    -- Process ESP Visuals
    if hrp then
        for target, indicator in pairs(indicators) do
            if target and target.Parent then
                local itemPos = getPartInfo(target)
                if itemPos then
                    local distance = (hrp.Position - itemPos).Magnitude
                    
                    -- Check if it's a player to bypass MaxDistance logic if needed, 
                    -- or apply it globally. We apply globally here.
                    local isPlayerTarget = Players:GetPlayerFromCharacter(target) ~= nil
                    local inRange = (CONFIG.MaxDistance == 0) or (distance <= CONFIG.MaxDistance)

                    local hl = highlighted[target]
                    if hl then 
                        hl.Enabled = inRange and (isPlayerTarget and CONFIG.PlayerESP or (not isPlayerTarget and CONFIG.Enabled))
                    end

                    if CONFIG.ShowDistance and inRange and hl and hl.Enabled then
                        local label = indicator:FindFirstChild("DistanceText")
                        if label then
                            local prefix = label:GetAttribute("Prefix")
                            if prefix then
                                label.Text = string.format("%s\n[ %d Studs ]", prefix, math.floor(distance + 0.5))
                            else
                                label.Text = string.format("[ %d Studs ]", math.floor(distance + 0.5))
                            end
                            indicator.Enabled = true
                        end
                    else
                        indicator.Enabled = false
                    end
                end
            end
        end
    end
end)

-- // Initial scan
updateESP()

