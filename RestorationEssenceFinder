-- ─────────────────────────────────────────────
-- Toggle logic
-- ─────────────────────────────────────────────
local function updateToggleVisuals()
	if notifierEnabled then
		pill.BackgroundColor3 = Color3.fromRGB(100, 220, 180)
		knob.Position = UDim2.new(1, -17, 0.5, -7)
		statusLabel.TextColor3 = Color3.fromRGB(100, 220, 180)
		statusLabel.Text = "ON"
		toggleStroke.Color = Color3.fromRGB(100, 220, 180)
	else
		pill.BackgroundColor3 = Color3.fromRGB(80, 80, 100)
		knob.Position = UDim2.new(0, 3, 0.5, -7)
		statusLabel.TextColor3 = Color3.fromRGB(120, 120, 140)
		statusLabel.Text = "OFF"
		toggleStroke.Color = Color3.fromRGB(80, 80, 100)
		-- Hide active notification if disabling
		if hideThread then task.cancel(hideThread) end
		frame.Visible = false
	end
end

clickBtn.MouseButton1Click:Connect(function()
	notifierEnabled = not notifierEnabled
	updateToggleVisuals()
end)

-- ─────────────────────────────────────────────
-- Notification display
-- ─────────────────────────────────────────────
local function showNotification(obj)
	if not notifierEnabled then return end

	local now = tick()
	if now - lastNotifyTime < NOTIFY_COOLDOWN then return end
	lastNotifyTime = now

	local pos = nil
	if obj:IsA("BasePart") then
		pos = obj.Position
	else
		local part = obj:FindFirstChildWhichIsA("BasePart", true)
		if part then pos = part.Position end
	end

	if pos and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
		local dist = math.floor((player.Character.HumanoidRootPart.Position - pos).Magnitude)
		subLabel.Text = string.format("📍 ~%d studs away", dist)
	else
		subLabel.Text = "📍 Check SpawnedItems!"
	end

	frame.Visible = true
	if hideThread then task.cancel(hideThread) end
	hideThread = task.delay(DISPLAY_DURATION, function()
		frame.Visible = false
		hideThread = nil
	end)
end

-- ─────────────────────────────────────────────
-- Detection
-- ─────────────────────────────────────────────
local function checkObject(obj)
	if obj.Parent == spawnedItems and obj.Name == ITEM_NAME and not trackedItems[obj] then
		trackedItems[obj] = true
		showNotification(obj)

		obj.AncestryChanged:Connect(function()
			if not obj:IsDescendantOf(spawnedItems) then
				trackedItems[obj] = nil
			end
		end)
	end
end

for _, obj in ipairs(spawnedItems:GetChildren()) do
	checkObject(obj)
end

spawnedItems.ChildAdded:Connect(checkObject)
