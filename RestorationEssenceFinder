-- // Cleanup Tasks
local function cleanup()
    for t in pairs(highlighted) do detachHighlight(t) end
    highlighted = {}; indicators = {}; highlightCount = 0; lastGrab = {}
end

if player then player.AncestryChanged:Connect(function(_, parent) if not parent then cleanup() end end) end
RunService.Heartbeat:Connect(function() if not Players.LocalPlayer or not Players.LocalPlayer.Parent then cleanup() end end)
