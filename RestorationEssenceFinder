--[[
    Restoration Essence ESP + Fluent UI (Separate AutoFarm Loop)
    -------------------------------------------------
    • ESP highlights items named "Restoration Essence"
    • Distance indicator (BillboardGui) showing stud distance
    • Native Fluent Keybind toggle, show/hide distance, max-distance culling
    • AutoFarm: Independent 3.5-second loop that grabs ground Essences to Backpack
    • Real-time spawn grabbing (DescendantAdded listener)
    • ESP Scans Workspace independently every 10 seconds
--]]

-- // Services
local RunService       = game:GetService("RunService")
local Players          = game:GetService("Players")
local Workspace        = game:GetService("Workspace")

-- // Fetch Fluent UI
local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()

-- // Configuration
local CONFIG = {
    ItemName     = "Restoration Essence",
    Color        = Color3.fromRGB(0, 255, 0),
    Transparency = 0.2,
    ScanInterval = 10,           -- ESP Scans every 10 seconds
    GrabInterval = 3.5,          -- AutoFarm Grabs every 3.5 seconds
    Enabled      = true,
    ShowDistance = true,
    MaxDistance  = 0,            -- 0 = no limit, otherwise studs
    AutoFarm     = false,        -- Auto-grabs items to Backpack
}

-- // Internal State
local highlighted    = {}    -- [target] = Highlight
local indicators     = {}    -- [target] = BillboardGui
local highlightCount = 0
local MAX_HIGHLIGHTS = 31    -- Roblox engine limit for active Highlights
local lastGrab       = {}    -- [target] = timestamp (anti-spam)

local player = Players.LocalPlayer

-- // Helper: Check if an item is sitting on the ground (not held by a player)
local function isGroundItem(target)
    if not target or not target.Parent then return false end

    local current = target
    while current and current ~= Workspace do
        if current:IsA("Backpack") or current:FindFirstChildOfClass("Humanoid") or Players:GetPlayerFromCharacter(current) then
            return false
        end
        current = current.Parent
    end

    return true
end

-- // Helper: Get world position and size (for BasePart or Model)
local function getPartInfo(target)
    if not target or not target.Parent then return nil, nil end

    if target:IsA("BasePart") then
        return target.Position, target.Size
    elseif target:IsA("Model") then
        local cf, size = target:GetBoundingBox()
        return cf.Position, size
    end
    return nil, nil
end

-- // Highlight & Indicator Management
local function attachHighlight(target)
    if not (target:IsA("BasePart") or target:IsA("Model")) then return end
    if highlighted[target] then return end
    if highlightCount >= MAX_HIGHLIGHTS then return end

    local highlight = Instance.new("Highlight")
    highlight.FillColor           = CONFIG.Color
    highlight.OutlineColor        = CONFIG.Color
    highlight.FillTransparency    = CONFIG.Transparency
    highlight.OutlineTransparency = 0
    highlight.Adornee             = target
    highlight.Parent              = target

    highlighted[target] = highlight
    highlightCount += 1
end

local function detachHighlight(target)
    local highlight = highlighted[target]
    if highlight then
        highlight:Destroy()
        highlighted[target] = nil
        highlightCount -= 1
    end

    local indicator = indicators[target]
    if indicator then
        indicator:Destroy()
        indicators[target] = nil
    end
    lastGrab[target] = nil
end

local function createIndicator(target)
    if not (target:IsA("BasePart") or target:IsA("Model")) then return end
    if indicators[target] then return indicators[target] end

    local bb = Instance.new("BillboardGui")
    bb.Name = "DistanceIndicator"
    bb.Adornee = target
    bb.Size = UDim2.new(0, 200, 0, 50)
    bb.AlwaysOnTop = true

    local _, size = getPartInfo(target)
    local offsetY = (size and size.Y / 2) or 0
    bb.StudsOffset = Vector3.new(0, offsetY + 2, 0)

    local tl = Instance.new("TextLabel")
    tl.Name = "DistanceText"
    tl.Size = UDim2.new(1, 0, 1, 0)
    tl.BackgroundTransparency = 1
    tl.TextStrokeTransparency = 0.75
    tl.TextColor3 = Color3.fromRGB(255, 255, 255)
    tl.Font = Enum.Font.SourceSansBold
    tl.TextScaled = true
    tl.Parent = bb

    bb.Parent = target
    indicators[target] = bb
    return bb
end

-- // Move an item directly to the player's Backpack
local function grabItem(target)
    if not target or not target.Parent then return end
    if not isGroundItem(target) then return end

    local backpack = player:FindFirstChild("Backpack")
    if not backpack then
        backpack = Instance.new("Backpack")
        backpack.Parent = player
    end
    target.Parent = backpack
end

-- // Grab nearest Essence (GROUND ONLY, moves to player's Backpack)
local function grabNearest()
    local character = player.Character
    if not character then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local nearest = nil
    local nearestDist = math.huge

    for _, desc in ipairs(Workspace:GetDescendants()) do
        if desc.Name == CONFIG.ItemName and (desc:IsA("BasePart") or desc:IsA("Model")) then
            if isGroundItem(desc) then
                local pos = getPartInfo(desc)
                if pos then
                    local dist = (hrp.Position - pos).Magnitude
                    if (CONFIG.MaxDistance == 0 or dist <= CONFIG.MaxDistance) and dist < nearestDist then
                        nearestDist = dist
                        nearest = desc
                    end
                end
            end
        end
    end

    if nearest then
        grabItem(nearest)
    end
end

-- // AutoFarm Check (Scans Workspace specifically to grab items)
local function runAutoFarm()
    if not CONFIG.AutoFarm then return end

    local character = player.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")

    for _, desc in ipairs(Workspace:GetDescendants()) do
        if desc.Name == CONFIG.ItemName and (desc:IsA("BasePart") or desc:IsA("Model")) then
            if isGroundItem(desc) then
                if hrp then
                    local pos = getPartInfo(desc)
                    if pos then
                        local dist = (hrp.Position - pos).Magnitude
                        if CONFIG.MaxDistance == 0 or dist <= CONFIG.MaxDistance then
                            grabItem(desc)
                        end
                    end
                else
                    grabItem(desc)
                end
            end
        end
    end
end

-- // AutoFarm Handler (Instant trigger when a new Essence appears)
local function onEssenceAdded(desc)
    if not (desc.Name == CONFIG.ItemName and (desc:IsA("BasePart") or desc:IsA("Model"))) then return end

    -- Attach ESP if enabled
    if CONFIG.Enabled then
        attachHighlight(desc)
        createIndicator(desc)
    end

    if not CONFIG.AutoFarm then return end
    if not isGroundItem(desc) then return end

    -- Cooldown check per item
    local now = tick()
    if lastGrab[desc] and now - lastGrab[desc] < 0.5 then return end
    lastGrab[desc] = now

    -- Check MaxDistance limit before auto-grabbing
    local character = player.Character
    if character then
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if hrp then
            local pos = getPartInfo(desc)
            if pos then
                local dist = (hrp.Position - pos).Magnitude
                if CONFIG.MaxDistance == 0 or dist <= CONFIG.MaxDistance then
                    grabItem(desc)
                end
            end
        end
    else
        grabItem(desc)
    end
end

-- // Core Workspace Scan (10-Second Loop)
local function updateESP()
    if not CONFIG.Enabled then
        for t in pairs(highlighted) do detachHighlight(t) end
        return
    end

    -- Clear removed or changed targets
    for t in pairs(highlighted) do
        if not t.Parent or t.Name ~= CONFIG.ItemName then
            detachHighlight(t)
        end
    end

    -- Scan full Workspace strictly for ESP
    for _, desc in ipairs(Workspace:GetDescendants()) do
        if desc.Name == CONFIG.ItemName and (desc:IsA("BasePart") or desc:IsA("Model")) then
            attachHighlight(desc)
            createIndicator(desc)
        end
    end
end

-- // Dedicated 10-Second ESP Scan Loop
task.spawn(function()
    while true do
        updateESP()
        task.wait(CONFIG.ScanInterval)
    end
end)

-- // Dedicated 3.5-Second AutoFarm Loop
task.spawn(function()
    while true do
        runAutoFarm()
        task.wait(CONFIG.GrabInterval)
    end
end)

-- // Render Loop (Smooth Distance Updates Per Frame)
RunService.RenderStepped:Connect(function()
    if not CONFIG.Enabled then return end

    local character = player and player.Character
    if not character then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local playerPos = hrp.Position

    for target, indicator in pairs(indicators) do
        if target and target.Parent then
            local itemPos = getPartInfo(target)
            if itemPos then
                local distance = (playerPos - itemPos).Magnitude
                local inRange  = (CONFIG.MaxDistance == 0) or (distance <= CONFIG.MaxDistance)

                local highlight = highlighted[target]
                if highlight then
                    highlight.Enabled = inRange and CONFIG.Enabled
                end

                if indicator then
                    if CONFIG.ShowDistance and inRange then
                        local label = indicator:FindFirstChild("DistanceText")
                        if label then
                            label.Text = string.format("[ %d Studs ]", math.floor(distance + 0.5))
                            indicator.Enabled = true
                        end
                    else
                        indicator.Enabled = false
                    end
                end
            else
                detachHighlight(target)
            end
        end
    end
end)

-- // Listen for newly-added Essences
Workspace.DescendantAdded:Connect(onEssenceAdded)

-- // Initial scan
updateESP()

-- // Fluent UI Setup
local Window = Fluent:CreateWindow({
    Title    = "Restoration Essence ESP",
    SubTitle = "v2.0 – Dual-Loop AutoFarm",
    TabWidth = 160,
    Size     = UDim2.fromOffset(480, 420),
    Theme    = "Dark",
})

local Tabs = {
    ESP = Window:AddTab({Title = "ESP Settings", Icon = "eye"})
}

-- UI Controls
local Toggle = Tabs.ESP:AddToggle("ESPToggle", {Title = "Enable ESP", Default = CONFIG.Enabled})
Toggle:OnChanged(function(state)
    CONFIG.Enabled = state
    if not state then
        for t in pairs(highlighted) do detachHighlight(t) end
    else
        updateESP()
    end
end)

local Keybind = Tabs.ESP:AddKeybind("ESPKeybind", {
    Title    = "Toggle Keybind",
    Mode     = "Toggle",
    Default  = "Z",
    Callback = function(state)
        Toggle:SetValue(state)
    end,
})

local ColorPicker = Tabs.ESP:AddColorpicker("ESPColor", {
    Title   = "ESP Colour",
    Default = CONFIG.Color
})
ColorPicker:OnChanged(function(col)
    CONFIG.Color = col
    for _, h in pairs(highlighted) do
        h.FillColor   = col
        h.OutlineColor = col
    end
end)

local TransparencySlider = Tabs.ESP:AddSlider("ESPTransparency", {
    Title    = "Transparency",
    Min      = 0,
    Max      = 1,
    Default  = CONFIG.Transparency,
    Rounding = 2
})
TransparencySlider:OnChanged(function(val)
    CONFIG.Transparency = val
    for _, h in pairs(highlighted) do
        h.FillTransparency = val
    end
end)

local DistanceToggle = Tabs.ESP:AddToggle("DistanceToggle", {Title = "Show Distance", Default = CONFIG.ShowDistance})
DistanceToggle:OnChanged(function(state)
    CONFIG.ShowDistance = state
end)

local MaxDistanceSlider = Tabs.ESP:AddSlider("MaxDistance", {
    Title    = "Max Distance (studs, 0=off)",
    Min      = 0,
    Max      = 500,
    Default  = CONFIG.MaxDistance,
    Rounding = 0
})
MaxDistanceSlider:OnChanged(function(val)
    CONFIG.MaxDistance = val
end)

local AutoFarmToggle = Tabs.ESP:AddToggle("AutoFarmToggle", {Title = "AutoFarm (Auto-Grab 3.5s)", Default = CONFIG.AutoFarm})
AutoFarmToggle:OnChanged(function(state)
    CONFIG.AutoFarm = state
    if state then
        runAutoFarm() -- Immediate check when turned on
    end
end)

Tabs.ESP:AddButton({
    Title    = "Grab Nearest (Ground Only)",
    Callback = function() grabNearest() end
})

Tabs.ESP:AddButton({
    Title    = "Scan Now",
    Callback = function() updateESP() end
})

-- // Cleanup Tasks
local function cleanup()
    for t in pairs(highlighted) do detachHighlight(t) end
    highlighted    = {}
    indicators     = {}
    highlightCount = 0
    lastGrab       = {}
end

if player then
    player.AncestryChanged:Connect(function(_, parent)
        if not parent then cleanup() end
    end)
end

RunService.Heartbeat:Connect(function()
    if not Players.LocalPlayer or not Players.LocalPlayer.Parent then
        cleanup()
    end
end)
