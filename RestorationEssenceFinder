--[[
    Restoration Essence ESP + Fluent UI (Complete & Stable)
--]]

-- // Services
local RunService = game:GetService("RunService")
local Players   = game:GetService("Players")
local Workspace = game:GetService("Workspace")

-- // Fetch Fluent UI
local Fluent = loadstring(game:HttpGet("https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"))()

-- // Configuration
local CONFIG = {
    ItemName     = "Restoration Essence",
    Color        = Color3.fromRGB(0, 255, 0),
    Transparency = 0.2,
    ScanInterval = 0.15,
    Enabled      = true,
    FolderName   = "Essences",
}

-- // Internal State
local highlighted    = {} -- [target] = Highlight
local indicators     = {} -- [target] = BillboardGui
local highlightCount = 0
local MAX_HIGHLIGHTS = 31 -- Roblox engine limit for active Highlights

local player = Players.LocalPlayer

-- Helper to safely calculate spatial center and dimensions
local function getPartInfo(target)
    if not target or not target.Parent then return nil, nil end

    if target:IsA("BasePart") then
        return target.Position, target.Size
    elseif target:IsA("Model") then
        local cf, size = target:GetBoundingBox()
        return cf.Position, size
    end
    return nil, nil
end

-- // Highlight & Indicator Management
local function attachHighlight(target)
    if not (target:IsA("BasePart") or target:IsA("Model")) then return end
    if highlighted[target] then return end
    if highlightCount >= MAX_HIGHLIGHTS then return end

    local highlight = Instance.new("Highlight")
    highlight.FillColor           = CONFIG.Color
    highlight.OutlineColor        = CONFIG.Color
    highlight.FillTransparency    = CONFIG.Transparency
    highlight.OutlineTransparency = 0
    highlight.Adornee             = target
    highlight.Parent              = target

    highlighted[target] = highlight
    highlightCount += 1
end

local function detachHighlight(target)
    local highlight = highlighted[target]
    if highlight then
        highlight:Destroy()
        highlighted[target] = nil
        highlightCount -= 1
    end

    local indicator = indicators[target]
    if indicator then
        indicator:Destroy()
        indicators[target] = nil
    end
end

local function createIndicator(target)
    if not (target:IsA("BasePart") or target:IsA("Model")) then return end
    if indicators[target] then return indicators[target] end

    local bb = Instance.new("BillboardGui")
    bb.Name = "DistanceIndicator"
    bb.Adornee = target
    bb.Size = UDim2.new(0, 200, 0, 50)
    bb.AlwaysOnTop = true

    local _, size = getPartInfo(target)
    local offsetY = (size and size.Y / 2) or 0
    bb.StudsOffset = Vector3.new(0, offsetY + 2, 0)

    local tl = Instance.new("TextLabel")
    tl.Name = "DistanceText"
    tl.Size = UDim2.new(1, 0, 1, 0)
    tl.BackgroundTransparency = 1
    tl.TextStrokeTransparency = 0.75
    tl.TextColor3 = Color3.fromRGB(255, 255, 255)
    tl.Font = Enum.Font.SourceSansBold
    tl.TextScaled = true
    tl.Parent = bb

    bb.Parent = target
    indicators[target] = bb
    return bb
end

-- // ESP Scan Logic
local function updateESP()
    if not CONFIG.Enabled then
        for t in pairs(highlighted) do detachHighlight(t) end
        return
    end

    -- Clear removed or renamed targets
    for t in pairs(highlighted) do
        if not t.Parent or t.Name ~= CONFIG.ItemName then
            detachHighlight(t)
        end
    end

    -- Dynamically check target root to handle late-loading folders
    local scanRoot = Workspace:FindFirstChild(CONFIG.FolderName) or Workspace
    for _, desc in ipairs(scanRoot:GetDescendants()) do
        if desc.Name == CONFIG.ItemName and (desc:IsA("BasePart") or desc:IsA("Model")) then
            attachHighlight(desc)
            createIndicator(desc)
        end
    end
end

-- // Main Heartbeat Scan Loop
local timer = 0
RunService.Heartbeat:Connect(function(dt)
    timer -= dt
    if timer <= 0 then
        updateESP()
        timer = CONFIG.ScanInterval
    end
end)

-- // Distance Updates (RenderStepped for fluid motion)
RunService.RenderStepped:Connect(function()
    if not CONFIG.Enabled then return end

    local character = player and player.Character
    if not character then return end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local playerPos = hrp.Position

    for target, indicator in pairs(indicators) do
        if target and target.Parent then
            local itemPos = getPartInfo(target)
            local label = indicator:FindFirstChild("DistanceText")
            if itemPos and label then
                local distance = (playerPos - itemPos).Magnitude
                label.Text = string.format("[ %d Studs ]", math.floor(distance + 0.5))
            end
        else
            detachHighlight(target)
        end
    end
end)

updateESP() -- Initial scan

-- // Fluent Window Initialization
local Window = Fluent:CreateWindow({
    Title    = "Restoration Essence ESP",
    SubTitle = "v1.0",
    TabWidth = 160,
    Size     = UDim2.fromOffset(480, 350),
    Theme    = "Dark",
})

local Tabs = {
    ESP = Window:AddTab({Title = "ESP Settings", Icon = "eye"})
}

-- Controls
local Toggle = Tabs.ESP:AddToggle("ESPToggle", {Title = "Enable ESP", Default = CONFIG.Enabled})
Toggle:OnChanged(function(state)
    CONFIG.Enabled = state
    if not state then
        for t in pairs(highlighted) do detachHighlight(t) end
    else
        updateESP()
    end
end)

local ColorPicker = Tabs.ESP:AddColorpicker("ESPColor", {
    Title   = "ESP Colour",
    Default = CONFIG.Color
})
ColorPicker:OnChanged(function(col)
    CONFIG.Color = col
    for _, h in pairs(highlighted) do
        h.FillColor   = col
        h.OutlineColor = col
    end
end)

local TransparencySlider = Tabs.ESP:AddSlider("ESPTransparency", {
    Title    = "Transparency",
    Min      = 0,
    Max      = 1,
    Default  = CONFIG.Transparency,
    Rounding = 2
})
TransparencySlider:OnChanged(function(val)
    CONFIG.Transparency = val
    for _, h in pairs(highlighted) do
        h.FillTransparency = val
    end
end)

local IntervalSlider = Tabs.ESP:AddSlider("ScanInterval", {
    Title    = "Scan Interval (s)",
    Min      = 0.05,
    Max      = 1,
    Default  = CONFIG.ScanInterval,
    Rounding = 2
})
IntervalSlider:OnChanged(function(val)
    CONFIG.ScanInterval = val
end)

Tabs.ESP:AddButton({
    Title    = "Scan Now",
    Callback = function() updateESP() end
})

-- // Cleanup Operations
local function cleanup()
    for t in pairs(highlighted) do detachHighlight(t) end
    highlighted    = {}
    indicators     = {}
    highlightCount = 0
end

if player then
    player.AncestryChanged:Connect(function(_, parent)
        if not parent then cleanup() end
    end)
end

RunService.Heartbeat:Connect(function()
    if not Players.LocalPlayer or not Players.LocalPlayer.Parent then
        cleanup()
    end
end)
