local p = game:GetService("Players").LocalPlayer
local running = false
local target = nil
local thread = nil
local PLAYER_SAFE_DISTANCE = 40
local SAFE_POS = Vector3.new(-35.773, -225.421, 407.197)
local sg = Instance.new("ScreenGui", p:WaitForChild("PlayerGui"))
sg.ResetOnSpawn = false
local b = Instance.new("TextButton", sg)
b.Size = UDim2.new(0, 100, 0, 50)
b.Position = UDim2.new(0.5, -50, 0.9, 0)
b.Text = "START"
b.BackgroundColor3 = Color3.fromRGB(0, 255, 0)

local function isPlayerNearby(zombie)
    local zombieRoot = zombie:FindFirstChild("HumanoidRootPart")
    if not zombieRoot then return true end
    for _, player in pairs(game:GetService("Players"):GetPlayers()) do
        if player == p then continue end
        local char = player.Character
        if not char then continue end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then continue end
        if (root.Position - zombieRoot.Position).Magnitude <= PLAYER_SAFE_DISTANCE then
            return true
        end
    end
    return false
end

local function isHiddenFromAllPlayers(zombie)
    local zombieRoot = zombie:FindFirstChild("HumanoidRootPart")
    if not zombieRoot then return false end
    local zombiePos = zombieRoot.Position
    for _, player in pairs(game:GetService("Players"):GetPlayers()) do
        if player == p then continue end
        local char = player.Character
        if not char then continue end
        local head = char:FindFirstChild("Head")
        if not head then continue end
        local rayOrigin = head.Position
        local rayDir = zombiePos - rayOrigin
        local raycastParams = RaycastParams.new()
        raycastParams.FilterDescendantsInstances = {char, zombie}
        raycastParams.FilterType = Enum.RaycastFilterType.Exclude
        local result = workspace:Raycast(rayOrigin, rayDir, raycastParams)
        if not result then
            return false
        end
    end
    return true
end

local function isSafeTarget(zombie)
    return isHiddenFromAllPlayers(zombie) and not isPlayerNearby(zombie)
end

local function getCharRefs()
    local char = p.Character or p.CharacterAdded:Wait()
    local h = char:WaitForChild("HumanoidRootPart")
    local r = char:WaitForChild("CHServer").Remotes.Input
    local t = p.Backpack:WaitForChild("Combat")
    return h, r, t
end

local function stopScript()
    running = false
    target = nil
    if thread then task.cancel(thread) end
    b.Text = "START"
    b.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
end

local function startScript()
    running = true
    b.Text = "STOP"
    b.BackgroundColor3 = Color3.fromRGB(255, 0, 0)

    local h, r, t = getCharRefs()

    h.CFrame = CFrame.new(-206.834, 7.000, 319.024)
    task.wait(0.5)
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("ProximityPrompt") then
            local part = v.Parent
            local pos = (part:IsA("BasePart") and part.Position) or (part:FindFirstChildWhichIsA("BasePart") and part:FindFirstChildWhichIsA("BasePart").Position)
            if pos and (pos - Vector3.new(-206.834, 7.000, 319.024)).Magnitude < 15 then
                fireproximityprompt(v)
                break
            end
        end
    end
    task.wait(0.5)
    t.Parent = p.Character

    task.spawn(function()
        while running do
            r:FireServer("G", true, 58.49479537497973)
            task.wait(6)
            r:FireServer("G", false, 434.3679775420169)
            task.wait(5)
        end
    end)

    task.spawn(function()
        while running do
            local function getTarget()
                for _, m in pairs(workspace:GetDescendants()) do
                    if m:IsA("Model") and m:FindFirstChild("Humanoid") and m:FindFirstChild("HumanoidRootPart") and m.Humanoid.Health > 0 then
                        if m.Name:sub(1, 6) == "Zombie" and isSafeTarget(m) then return m end
                    end
                end
                return nil
            end
            local nextBest = getTarget()
            local dead = (target and (not target.Parent or target.Humanoid.Health <= 0))
            local exposed = (target and not isSafeTarget(target))

            if not target or dead or exposed or nextBest ~= target then
                if exposed then
                    target = nil
                    if thread then task.cancel(thread) thread = nil end
                    h.CFrame = CFrame.new(SAFE_POS)
                end
                if not nextBest then
                    h.CFrame = CFrame.new(SAFE_POS)
                end
                if target ~= nextBest then
                    target = nextBest
                    if thread then task.cancel(thread) thread = nil end
                    if target then
                        thread = task.spawn(function()
                            while running and target and target.Parent and target.Humanoid.Health > 0 do
                                if not isSafeTarget(target) then
                                    target = nil
                                    h.CFrame = CFrame.new(SAFE_POS)
                                    break
                                end
                                local root = target.HumanoidRootPart
                                h.CFrame = CFrame.new((root.CFrame * CFrame.new(0, 0, 4)).Position, root.Position)
                                task.wait(0.05)
                            end
                        end)
                    end
                end
            end
            task.wait(1)
        end
    end)

    task.spawn(function()
        while running do
            if target and target:FindFirstChild("HumanoidRootPart") and target.Humanoid.Health > 0 then
                for i = 1, 3 do
                    if not running then break end
                    r:FireServer("M1", true, 397.77875450000283)
                    task.wait(0.05)
                    r:FireServer("M1", false, 397.77875450000283)
                    task.wait(0.55)
                end
                task.wait(0.1)
            else
                task.wait(0.5)
            end
        end
    end)
end

p.CharacterAdded:Connect(function(char)
    if running then
        stopScript()
        char:WaitForChild("HumanoidRootPart")
        char:WaitForChild("CHServer")
        task.wait(2)
        startScript()
    end
end)

b.MouseButton1Click:Connect(function()
    if running then
        stopScript()
    else
        startScript()
    end
end)
