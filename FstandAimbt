    setPanelOpen(not panelOpen)
end)

-- ================= DRAG LOGIC =================

local draggingPanel = false
local dragStartPos = Vector2.new()
local panelStartPos = Vector2.new()

dragHandle.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or
       input.UserInputType == Enum.UserInputType.Touch then
        draggingPanel = true
        dragStartPos = input.Position
        panelStartPos = Vector2.new(
            panel.Position.X.Offset,
            panel.Position.Y.Offset
        )
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if draggingPanel then
        if input.UserInputType == Enum.UserInputType.MouseMovement or
           input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - dragStartPos
            local vp = camera.ViewportSize
            local newX = math.clamp(panelStartPos.X + delta.X, 0, vp.X - panel.AbsoluteSize.X)
            local newY = math.clamp(panelStartPos.Y + delta.Y, 0, vp.Y - panel.AbsoluteSize.Y)
            panel.Position = UDim2.new(0, newX, 0, newY)
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or
       input.UserInputType == Enum.UserInputType.Touch then
        draggingPanel = false
    end
end)

-- ================= SLIDER LOGIC =================

local sliderDragging = false

local function updateSlider(pct)
    pct = math.clamp(pct, 0, 1)
    fill.Size = UDim2.new(pct, 0, 1, 0)
    knob.Position = UDim2.new(pct, -8, 0.5, -8)
    fovRadius = math.floor(FOV_MIN + pct * (FOV_MAX - FOV_MIN))
    fovCircle.Size = UDim2.new(0, fovRadius * 2, 0, fovRadius * 2)
    fovLabel.Text = "FOV: " .. fovRadius
end

sliderTrack.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or
       input.UserInputType == Enum.UserInputType.MouseButton1 then
        sliderDragging = true
        local pct = (input.Position.X - sliderTrack.AbsolutePosition.X) / sliderTrack.AbsoluteSize.X
        updateSlider(pct)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if not sliderDragging then return end
    if input.UserInputType == Enum.UserInputType.Touch or
       input.UserInputType == Enum.UserInputType.MouseMovement then
        local pct = (input.Position.X - sliderTrack.AbsolutePosition.X) / sliderTrack.AbsoluteSize.X
        updateSlider(pct)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or
       input.UserInputType == Enum.UserInputType.MouseButton1 then
        sliderDragging = false
    end
end)

