-- ================= TARGET SYSTEM =================

local function getTargets()
    local center = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
    targets = {}
    for _, zombie in ipairs(zombiesFolder:GetChildren()) do
        local head = zombie:FindFirstChild("Head")
        if head then
            local pos, onScreen = camera:WorldToScreenPoint(head.Position)
            if onScreen then
                local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                if dist <= fovRadius then
                    table.insert(targets, { head = head, dist = dist })
                end
            end
        end
    end
    table.sort(targets, function(a, b) return a.dist < b.dist end)
end

local function getTarget()
    if #targets == 0 then return nil end
    index = math.clamp(index, 1, #targets)
    return targets[index].head
end

local function switchTarget(dir)
    if #targets == 0 then return end
    index += dir
    if index < 1 then index = #targets end
    if index > #targets then index = 1 end
end

-- ================= SCROLL WHEEL =================

UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseWheel then
        switchTarget(input.Position.Z > 0 and -1 or 1)
    end
end)

-- ================= HOLD E =================

local holdingE = false
local eTimer = 0
local E_SWITCH_RATE = 0.3

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.E then holdingE = true end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.E then
        holdingE = false
        eTimer = 0
    end
end)

-- ================= MAIN LOOP =================

RunService.RenderStepped:Connect(function(dt)
    getTargets()

    if holdingE and aimAssistEnabled then
        eTimer += dt
        if eTimer >= E_SWITCH_RATE then
            eTimer = 0
            switchTarget(1)
        end
    end

    -- Smooth flick detection
    if not switchCooldown then
        local currentCam = camera.CFrame
        local relative = lastCamCFrame:ToObjectSpace(currentCam)
        local _, yaw, _ = relative:ToEulerAnglesYXZ()

        flickTimer += dt

        if yawAccum ~= 0 and (yaw * yawAccum < 0) then
            yawAccum = 0
            flickTimer = 0
        end

        yawAccum += yaw

        if flickTimer > FLICK_WINDOW then
            yawAccum = 0
            flickTimer = 0
        end

        if math.abs(yawAccum) >= FLICK_THRESHOLD then
            switchCooldown = true
            local dir = yawAccum < 0 and 1 or -1
            switchTarget(dir)
            yawAccum = 0
            flickTimer = 0

            swipeLabel.Text = dir == 1 and "→ Switched" or "← Switched"
            swipeLabel.TextColor3 = Color3.fromRGB(100, 220, 255)

            task.delay(SWITCH_COOLDOWN, function()
                switchCooldown = false
                swipeLabel.Text = "↔ Flick cam to switch"
                swipeLabel.TextColor3 = Color3.fromRGB(80, 80, 120)
            end)
        end
    else
        yawAccum = 0
        flickTimer = 0
    end

    lastCamCFrame = camera.CFrame

    targetLabel.Text = #targets > 0
        and ("Target " .. index .. " / " .. #targets)
        or "Target: —"

    if aimAssistEnabled then
        local target = getTarget()
        if target then
            lockIcon.Text = "🔒"
            camera.CFrame = CFrame.lookAt(camera.CFrame.Position, target.Position)
        else
            lockIcon.Text = ""
        end
    else
        lockIcon.Text = ""
    end
end)
